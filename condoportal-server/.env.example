# Puerto del servidor de la API
PORT=3000

# Secreto para firmar los JWT. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRACION=8h

# Base de datos (Sprint 3). Si se deja vacío, el servidor arranca con el
# almacén en memoria y los datos de ejemplo de src/db/seed.js.
#
#   PostgreSQL local:  postgres://usuario:clave@localhost:5432/condoportal
#   Supabase:          postgres://postgres:CLAVE@db.PROYECTO.supabase.co:5432/postgres
DATABASE_URL=

# Los proveedores administrados (Supabase, Neon, Railway) exigen TLS.
# Pon false sólo para una base local sin certificado.
DATABASE_SSL=true

# Orígenes permitidos por CORS en producción, separados por coma.
CORS_ORIGINS=http://localhost:5173
